# Homebucket 环境变量模板
# 使用方式：cp .env.example .env，然后按自己的环境填写（.env 已被 git 忽略）

# ---- 通用 ----
NODE_ENV=development

# ---- 数据库 ----
# DB_PROVIDER: mysql | sqlite（sqlite 即“MySQL light”，文件型数据库，无需额外服务）
DB_PROVIDER=mysql
# mysql 连接串：mysql://<user>:<password>@<host>:<port>/<database>
# 注意：不要加引号，`docker run --env-file .env` 不会去掉引号
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
# Prisma migrate dev 在 MySQL 上需要一个影子库（空库，仅开发期使用）
# SHADOW_DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>_shadow"
# 进程启动时自动执行 prisma migrate deploy（空库首次启动也能自动建表）
AUTO_MIGRATE=true
# sqlite 数据库文件路径（DB_PROVIDER=sqlite 时生效）
DB_FILE_PATH=file:./data/homebucket.db

# ---- 后端 Nest（server/）----
SERVER_PORT=3001
API_PREFIX=api
# 允许跨域的来源，多个用逗号分隔；* 表示全部放行（前端已 0.0.0.0 对外，建议用 * 或写死局域网 IP）
CORS_ORIGIN=*
# 单个请求体 / 上传文件的最大尺寸，支持 1024 / 10mb / 1gb
MAX_UPLOAD_SIZE=1gb

# 日志
# LOG_LEVEL: error | warn | info | debug | verbose（级别越高输出越多）
LOG_LEVEL=info
# LOG_FORMAT: pretty（彩色人类可读） | json（单行 JSON） | nginx（nginx 风格）
LOG_FORMAT=pretty
# 是否输出 HTTP 访问日志（nginx combined 风格）
LOG_ACCESS=true

# 认证
JWT_SECRET=replace-with-a-random-string
JWT_EXPIRES_IN=7d

# ---- 前端 Nuxt（web/）----
# 监听地址：0.0.0.0 表示允许局域网 / 容器外访问
WEB_HOST=0.0.0.0
WEB_PORT=3000
# 浏览器访问后端的地址。默认 /api 走 Nuxt 内置代理（同源，天然无跨域）
NUXT_PUBLIC_API_BASE=/api
# 服务端渲染时访问后端的地址（容器内直连）
NUXT_API_BASE=http://127.0.0.1:3001/api
# Nuxt 代理 /api 的目标地址
API_PROXY_TARGET=http://127.0.0.1:3001
