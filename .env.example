# Homebucket 环境变量模板
# 使用方式：cp .env.example .env，然后按自己的环境填写（.env 已被 git 忽略）
#
# ── 这里只剩两类变量 ──
#
#   1. **数据库连接**：它必须在"连上库之前"就能读到 —— 其余配置存在库里，
#      而连接参数本身存不进库（先有鸡还是先有蛋），所以只能在这里。
#   2. **前端 Nuxt 进程的监听参数**：那是另一个进程，后端改不了它。
#
# 其余配置全部改由**首启引导页**完成，之后可在「设置 → 实例设置」里随时调整：
# 优先级为 **数据库 > .env > 内置默认值**，界面里改过的值就不再用这里的了。
#
# ⚠️ 不要再往这个文件里加新的配置项：`server/test/settings.test.mjs` 有一条守卫，
#    只允许"数据库变量 + 前端进程变量"出现在这里 —— 加了会让 CI 失败。
#    新增配置请登记到 `server/src/settings/settings.registry.ts`。
#
# 容器内还有一组例外：数据目录 / 上传目录 / SQLite 库文件被钉死在 /data
# （镜像里唯一挂卷点），界面里看不到、也改不动，避免误改导致数据丢失。

# ---- 数据库 ----
# DB_PROVIDER: mysql | sqlite（sqlite 即“MySQL light”，文件型数据库，无需额外服务）；默认 mysql
# 驱动：mysql → mysql2；sqlite → better-sqlite3（两者都已打进镜像，可在运行期切换）
DB_PROVIDER=mysql
# mysql 连接串：mysql://<user>:<password>@<host>:<port>/<database>；无默认，mysql 下必填
# 注意：不要加引号，`docker run --env-file .env` 不会去掉引号
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
# 上面的连接串可以用下面这几项单独覆盖（任一项留空则回退到连接串里的值）
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
# 进程启动时自动执行数据库迁移（空库首次启动也能自动建表）；默认 true
AUTO_MIGRATE=true
# sqlite 数据库文件路径（DB_PROVIDER=sqlite 时生效）；默认 ./data/homebucket.db
# 兼容历史的 Prisma 写法，可以带 `file:` 前缀（会被自动去掉）
# 容器内这一项固定为 /data/homebucket.db（首启引导里选了 sqlite 就会用它）
DB_FILE_PATH=./data/homebucket.db

# ---- 前端 Nuxt（web/）----
# 监听地址；默认 0.0.0.0（允许局域网 / 容器外访问）
WEB_HOST=0.0.0.0
# 监听端口；默认 3000
WEB_PORT=3000
