# Homebucket 环境变量模板
# 使用方式：cp .env.example .env，然后按自己的环境填写（.env 已被 git 忽略）
#
# 每条上面的注释里都标了「默认」——即该变量**不填**时代码里的回退值
# （后端见 server/src/config/env.ts，前端见 web/nuxt.config.ts）。
#
# ── 这里不再是唯一的配置入口 ──
# 除下面两类之外，**所有变量都可以在「设置 → 实例设置」里查看与修改**（仅实例管理员可见），
# 优先级是：数据库里保存的值 > 这里的 .env > 代码里的默认值。
# 也就是说，本文件里填的是**默认值**，界面上改过之后以界面为准（清空该项即回到这里）。
# 只能在 .env 里改的两类：
#   1. 数据库连接（DB_PROVIDER / DATABASE_URL / DB_* / DB_FILE_PATH）与 AUTO_MIGRATE
#      —— 要连上库才能读到"配置存在库里"，用库里的配置去配数据库是循环；
#      AUTO_MIGRATE 还决定"要不要跑迁移"，而迁移正是建出那张配置表的一步。
#   2. 前端 Nuxt 进程的 WEB_* / NUXT_* / API_PROXY_TARGET
#      —— 属于另一个进程（其中 API_PROXY_TARGET 还是构建期就烘焙进产物的）。
# 界面上会标注哪些项「需重启生效」（端口、JWT 密钥、存储驱动这类只在启动时读取的），
# 所以本文件里不重复标；那张清单的唯一来源是 server/src/settings/settings.registry.ts。

# ---- 通用 ----（可在「设置 → 实例设置」覆盖）
# 运行环境；默认 development
NODE_ENV=development

# ---- 数据库 ----（⚠️ 只能在 .env 配置，不进设置页）
# DB_PROVIDER: mysql | sqlite（sqlite 即“MySQL light”，文件型数据库，无需额外服务）；默认 mysql
# 驱动：mysql → mysql2；sqlite → better-sqlite3（两者都已打进镜像，可在运行期切换）
DB_PROVIDER=mysql
# mysql 连接串：mysql://<user>:<password>@<host>:<port>/<database>；无默认，mysql 下必填
# 注意：不要加引号，`docker run --env-file .env` 不会去掉引号
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<database>
# 上面的连接串可以用下面这几项单独覆盖（任一项留空则回退到连接串里的值）
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
# 进程启动时自动执行数据库迁移（空库首次启动也能自动建表）；默认 true
AUTO_MIGRATE=true
# sqlite 数据库文件路径（DB_PROVIDER=sqlite 时生效）；默认 ./data/homebucket.db
# 兼容历史的 Prisma 写法，可以带 `file:` 前缀（会被自动去掉）
# Docker 里建议 DB_FILE_PATH=/data/homebucket.db
DB_FILE_PATH=./data/homebucket.db

# ---- 后端 Nest（server/）----（可在「设置 → 实例设置」覆盖）
# 后端监听端口；默认 3001
SERVER_PORT=3001
# 路由前缀；默认 api
API_PREFIX=api
# 允许跨域的来源，多个用逗号分隔；默认 *（全部放行）。前端已 0.0.0.0 对外，建议用 * 或写死局域网 IP
CORS_ORIGIN=*
# 单个请求体 / 上传文件的最大尺寸；默认 1gb，支持 1024 / 10mb / 1gb
MAX_UPLOAD_SIZE=1gb

# ---- 日志 ----（可在「设置 → 实例设置」覆盖）
# LOG_LEVEL: error | warn | info | debug | verbose（级别越高输出越多，info 等价 Nest 的 log）；默认 info
LOG_LEVEL=info
# LOG_FORMAT: pretty（彩色人类可读） | json（单行 JSON） | nginx（nginx 风格）；默认 pretty
LOG_FORMAT=pretty
# 是否输出 HTTP 访问日志（nginx combined 风格）；默认 true
LOG_ACCESS=true

# ---- 数据目录与文件存储 ----（可在「设置 → 实例设置」覆盖）
# 数据根目录，相对路径按 server/ 运行目录解析；默认 data（Docker 里建议 /data 并挂卷）
DATA_DIR=./data
# 上传文件目录；默认留空 → 取 ${DATA_DIR}/uploads
UPLOAD_DIR=
# local = 落本地磁盘并由后端 /api/media/<key> 静态服务；s3 = 走 S3 兼容对象存储。默认 local
STORAGE_DRIVER=local
# 以下 6 项仅在 STORAGE_DRIVER=s3 时生效（默认值见每行上方注释）
# S3_ENDPOINT 默认留空
S3_ENDPOINT=
# S3_REGION 默认 us-east-1
S3_REGION=
# S3_BUCKET 默认留空
S3_BUCKET=
# S3_ACCESS_KEY 默认留空
S3_ACCESS_KEY=
# S3_SECRET_KEY 默认留空
S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE 默认 true
S3_FORCE_PATH_STYLE=true
# 新家庭默认主货币（物品金额只使用家庭主货币）；默认 CNY
DEFAULT_CURRENCY=CNY
# 默认语言（家庭设置里可覆盖）；默认 zh-CN
DEFAULT_LOCALE=zh-CN
# 对外可访问的站点根地址，二维码会写成 <PUBLIC_BASE_URL>/r/<token>；默认留空（二维码只写 token）
# 局域网使用示例：PUBLIC_BASE_URL=http://192.168.1.10:3000
PUBLIC_BASE_URL=

# ---- 首次初始化 / 默认管理员 ----（可在「设置 → 实例设置」覆盖）
# 空库首次启动或首次执行 npm run seed 时，用这组账号创建管理员；默认 true（即默认会创建）
AUTO_CREATE_ADMIN=true
# 以下三项不填时的默认值：admin / admin / admin@example.com（正式环境务必修改）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_EMAIL=admin@example.com

# ---- 条码数据收集（默认开启）----（可在「设置 → 实例设置」覆盖）
# 由开发者提供的独立服务收集「条码 → 物品信息」，综合判定后同步给各实例，便于快速填写
# 总开关；默认 true。关闭后本实例完全不向外部发送请求
DATA_COLLECTION_ENABLED=true
# 收集服务地址（独立项目，请替换成你自己的）；默认留空 = 视为未配置，跳过请求
DATA_COLLECTION_ENDPOINT=https://barcode.homebucket.dev/api/v1
# 是否把本实例填写的新条码信息回传（帮助其他实例）；默认 true
DATA_COLLECTION_SUBMIT=true
# 查询/上报的请求超时（毫秒）；默认 1500，超时静默降级
DATA_COLLECTION_TIMEOUT_MS=1500

# ---- 定时上报（默认开启）----（可在「设置 → 实例设置」覆盖）
# 定时把本实例**所有带条码的物品**报给收集服务，走的是收集器的 v1 实例协议：
# 首次运行先 POST /api/v1/instances 注册，拿到只返回一次的 hbc_… key，之后每次请求带 x-collector-key；
# 库里没有 key 时回退到上面那个无凭据的 /observations 老契约。
# 上报的只有文字字段：barcode / name / description / model / manufacturer / baseUnit，
# 数量、价格、位置、序列号、追溯码一律不发；Item 没有 category 列，所以也不发分类。
# 每个物品记 collectorFingerprint，指纹没变就直接跳过（连请求都不发），重复运行是幂等的。
# 照片只在收集器回 wantsPhotos（该条目一张图都没有）时上传，且**每张都先剥离 EXIF/GPS/相机参数/XMP/ICC**。
# key 存在 DataCollectionState 表里（明文——协议要求每次请求都出示它）：拿到库 dump 就等于拿到凭据，
# 轮换方式就是删掉那一行让它重新注册；日志只打 key 前缀。
# 总开关；默认 true。设 false 即完全不跑定时上报（扫码查询不受影响）
DATA_COLLECTION_SYNC_ENABLED=true
# 执行时机，cron 表达式；默认 0 0 3 * * *（每天凌晨 3 点）
# ⚠️ 必须写 6 段（秒 分 时 日 月 周）；5 段会被判为无效表达式，定时任务注册不上
DATA_COLLECTION_SYNC_CRON=0 0 3 * * *
# 单轮最多处理多少个物品；默认 500
DATA_COLLECTION_SYNC_MAX_ITEMS=500
# 相邻两个物品之间的间隔（毫秒），避免大库存把收集服务打挂；默认 250
DATA_COLLECTION_SYNC_THROTTLE_MS=250
# 连续失败多少次就放弃本轮（下一轮再试，不会永久停摆）；默认 5
DATA_COLLECTION_SYNC_MAX_FAILURES=5
# 单张照片的上传超时（毫秒）；默认 15000
DATA_COLLECTION_PHOTO_TIMEOUT_MS=15000
# 单张照片的字节上限；默认 8388608（8MB），超过就跳过这张，不影响文字字段上报
DATA_COLLECTION_PHOTO_MAX_BYTES=8388608
# 单个物品最多传几张照片；默认 12（与收集器单条目图片上限一致）
DATA_COLLECTION_PHOTO_MAX_PER_ITEM=12

# ---- 认证 ----（可在「设置 → 实例设置」覆盖）
# JWT 签名密钥；默认 homebucket-dev-secret（正式环境务必改）
JWT_SECRET=replace-with-a-random-string
# 凭证有效期；默认 7d
JWT_EXPIRES_IN=7d
# 是否开放注册；默认 true（开放）。设为 false 后拒绝一切注册请求（含凭邀请链接注册），
# 已有账号照常登录；前端注册入口会自动隐藏
ALLOW_REGISTRATION=true

# ---- 前端 Nuxt（web/）----（⚠️ 属于前端进程，只能在 .env 配置）
# 监听地址；默认 0.0.0.0（允许局域网 / 容器外访问）
WEB_HOST=0.0.0.0
# 监听端口；默认 3000
WEB_PORT=3000
# 浏览器访问后端的地址；默认 /api（走 Nuxt 内置代理，同源，天然无跨域）
NUXT_PUBLIC_API_BASE=/api
# 服务端渲染时访问后端的地址；默认 ${API_PROXY_TARGET}/api（容器内直连）
NUXT_API_BASE=http://127.0.0.1:3001/api
# Nuxt 代理 /api 的目标地址；默认 http://127.0.0.1:3001
API_PROXY_TARGET=http://127.0.0.1:3001
