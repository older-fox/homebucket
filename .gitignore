# 依赖
node_modules/

# 构建产物
dist/
.output/
.nuxt/
.nitro/
.cache/
.temp/
# TS 增量编译信息（incremental: true 的副产物）
*.tsbuildinfo

# 本项目用 npm 管理依赖，忽略 pnpm 产物
pnpm-lock.yaml
pnpm-workspace.yaml

# 环境变量（.env.example 需要提交）
.env
.env.local
.env.*.local

# sqlite 数据文件（MySQL light）
*.db
*.db-journal

# 本地数据目录（上传的文件、sqlite 默认位置、迁移前的 dump 备份）
server/data/

# 日志 / 编辑器
*.log
npm-debug.log*
.DS_Store
.idea/*
!.idea/.gitkeep
# AI 编码工具的工作目录（里面是嵌套 git worktree，提交进来会破坏仓库）
.codebuddy/
