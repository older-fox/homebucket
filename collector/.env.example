# HomeBucket 收集器环境变量 —— 复制成 collector/.env 后按需修改。
# 它是独立程序：只读自己工作目录（collector/）下的 .env，不读仓库根目录的 .env，也不读 HomeBucket 主服务的配置。

# ── 监听 ──────────────────────────────────────────────────────────────
# 端口/地址：dev（nuxt dev）与生产（scripts/start.mjs）都读这两个。
# 迁移到 Nuxt/Nitro 后不再有 COLLECTOR_API_PREFIX 与 COLLECTOR_WEB_DIR：
# 路由前缀由 server/api 的目录结构决定（/api/**），页面由 Nuxt 自己提供。
COLLECTOR_PORT=3400
COLLECTOR_HOST=0.0.0.0

# ── 存储 ──────────────────────────────────────────────────────────────
# v1 只支持 sqlite（单文件、零外部依赖；收集器读多写少，够用很久）。填别的会显式启动失败。
COLLECTOR_DB_PROVIDER=sqlite
# 相对路径按**启动时的工作目录**解析（Nitro 下没有稳定的 __dirname）
COLLECTOR_DB_FILE_PATH=data/collector.db
# 启动时自动跑迁移（生产建议 true：镜像里不必再单独跑一次迁移）
COLLECTOR_AUTO_MIGRATE=true

# ── 管理员账号（纠错台登录） ──────────────────────────────────────────
# 纠错台（改字段/屏蔽上报/合并物品/封禁实例）用账号 + 口令登录：口令以 scrypt 哈希
# 存在库里，登录成功后服务端发一个 httpOnly 会话 cookie（前端拿不到令牌，也就偷不走）。
#
# 账号在**首次启动、库里还没有管理员时**按这两项创建（"初始化时直接创建"）；
# 之后在界面上改密码即可，.env 里的口令不会再覆盖已改过的密码 ——
# 想把口令强行改回 .env 的值，把 COLLECTOR_ADMIN_FORCE_RESET 设成 true 重启一次
# （会同时作废该账号的全部登录会话），改完记得关掉。
#
# 生产环境（NODE_ENV=production）必须显式设置口令且 ≥8 字符，否则拒绝启动。
# 开发环境留空也行：会回退到账号 admin / 口令 dev-admin-password，npm run dev 开箱可用。
# 口令**不做 trim**：两端的空格也是口令的一部分，别"顺手"去掉。
# 注意：实例上报**不需要**账号 —— 实例是自我注册的，见 README 的协议说明。
COLLECTOR_ADMIN_USERNAME=admin
COLLECTOR_ADMIN_PASSWORD=
COLLECTOR_ADMIN_FORCE_RESET=false

# 登录会话有效期（小时，默认 168 = 7 天；越界或读不懂回退默认值）。
# 会话是"滑动续期"的：剩余不足一半时，每次带 cookie 的请求会把它续到满。
COLLECTOR_SESSION_TTL_HOURS=168

# 登录尝试限流（每个来源 IP 一个固定窗口，默认 10 次 / 10 分钟）。
# 管理接口整体不限流（运维批量纠错会咬到自己），只有登录接口单独限流 ——
# 否则猜口令是零成本的。
COLLECTOR_LOGIN_RATE_LIMIT=10
COLLECTOR_LOGIN_RATE_WINDOW_MS=600000

# ── 开关与限额 ────────────────────────────────────────────────────────
# 是否允许实例自我注册（默认开）。关掉后只有已注册的实例能上报，新实例拿到 403。
COLLECTOR_REGISTRATION_OPEN=true

# 对外访问控制
COLLECTOR_CORS_ORIGIN=*
COLLECTOR_MAX_BODY_SIZE=64kb
# 每个来源 IP 在每个窗口内的请求上限（查询/注册/上报共用一份预算；管理接口不限流）
COLLECTOR_RATE_LIMIT=240
COLLECTOR_RATE_WINDOW_MS=60000

NODE_ENV=development
