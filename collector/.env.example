# HomeBucket 收集器环境变量 —— 复制成 collector/.env 后按需修改。
# 它是独立程序：只读自己工作目录（collector/）下的 .env，不读仓库根目录的 .env，也不读 HomeBucket 主服务的配置。

# ── 监听 ──────────────────────────────────────────────────────────────
# 端口/地址：dev（nuxt dev）与生产（scripts/start.mjs）都读这两个。
# 迁移到 Nuxt/Nitro 后不再有 COLLECTOR_API_PREFIX 与 COLLECTOR_WEB_DIR：
# 路由前缀由 server/api 的目录结构决定（/api/**），页面由 Nuxt 自己提供。
COLLECTOR_PORT=3400
COLLECTOR_HOST=0.0.0.0

# ── 存储 ──────────────────────────────────────────────────────────────
# v1 只支持 sqlite（单文件、零外部依赖；收集器读多写少，够用很久）。填别的会显式启动失败。
COLLECTOR_DB_PROVIDER=sqlite
# 相对路径按**启动时的工作目录**解析（Nitro 下没有稳定的 __dirname）
COLLECTOR_DB_FILE_PATH=data/collector.db
# 启动时自动跑迁移（生产建议 true：镜像里不必再单独跑一次迁移）
COLLECTOR_AUTO_MIGRATE=true

# ── 管理员账号（纠错台登录） ──────────────────────────────────────────
# 纠错台（改字段/屏蔽上报/合并物品/封禁实例）用账号 + 口令登录：口令以 scrypt 哈希
# 存在库里，登录成功后服务端发一个 httpOnly 会话 cookie（前端拿不到令牌，也就偷不走）。
#
# 账号在**首次启动、库里还没有管理员时**按这两项创建（"初始化时直接创建"）；
# 之后在界面上改密码即可，.env 里的口令不会再覆盖已改过的密码 ——
# 想把口令强行改回 .env 的值，把 COLLECTOR_ADMIN_FORCE_RESET 设成 true 重启一次
# （会同时作废该账号的全部登录会话），改完记得关掉。
#
# 生产环境（NODE_ENV=production）必须显式设置口令且 ≥8 字符，否则拒绝启动。
# 开发环境留空也行：会回退到账号 admin / 口令 dev-admin-password，npm run dev 开箱可用。
# 口令**不做 trim**：两端的空格也是口令的一部分，别"顺手"去掉。
# 注意：实例上报**不需要**账号 —— 实例是自我注册的，见 README 的协议说明。
COLLECTOR_ADMIN_USERNAME=admin
COLLECTOR_ADMIN_PASSWORD=
COLLECTOR_ADMIN_FORCE_RESET=false

# 登录会话有效期（小时，默认 168 = 7 天；越界或读不懂回退默认值）。
# 会话是"滑动续期"的：剩余不足一半时，每次带 cookie 的请求会把它续到满。
COLLECTOR_SESSION_TTL_HOURS=168

# 登录尝试限流（每个来源 IP 一个固定窗口，默认 10 次 / 10 分钟）。
# 管理接口整体不限流（运维批量纠错会咬到自己），只有登录接口单独限流 ——
# 否则猜口令是零成本的。
COLLECTOR_LOGIN_RATE_LIMIT=10
COLLECTOR_LOGIN_RATE_WINDOW_MS=600000

# ── 来源身份与投票权重 ────────────────────────────────────────────────
# 上报全是匿名的，投票身份只能从请求本身推导：先看自报 ID（x-collector-source 头 /
# 请求体 sourceId / ?source= 查询参数，按可信度依次取），没有再退回 IP + User-Agent
# 指纹。指纹只存 sha256，不存 IP 原文（IP 是个人信息，能区分就够，不需要还原）。
COLLECTOR_TRUST_PROXY=false

# 只靠 IP+UA 指纹认出来的来源是否参与计票（默认 true）。
# 关掉后它们仍会入审计、仍会被展示，但不投票 —— 这是给"NAT 后面多个实例被合并成
# 同一个指纹、于是一票顶多票"这种情况留的开关。注意关掉会让同一个出口 IP 后面的
# 所有实例都变得无票可投，通常不如给实例配上自报 ID。
COLLECTOR_SOURCE_FINGERPRINT_VOTES=true

# 反馈加权：一个来源对某个字段的权重。
#
# 权重的算法是 initial × up^好评数 ÷ down^差评数，再夹到 [min, max]，
# 所以 up 越大越"慷慨"、down 越大越"严厉"。投票按**权重和**排序（不是票数），
# 权重相同才看票数 —— 这才是"反馈能改变下发结果"生效的地方。
# 好评、差评各按「一个来源对一个字段只有一票」去重。
COLLECTOR_WEIGHT_INITIAL=1
COLLECTOR_WEIGHT_UP=1.2
COLLECTOR_WEIGHT_DOWN=1.5
COLLECTOR_WEIGHT_MIN=0.05
COLLECTOR_WEIGHT_MAX=5

# ── 照片存储 ──────────────────────────────────────────────────────────
# local：存到磁盘，由收集器自己经 GET /api/photos/<hash> 提供图片。
# s3   ：存到 S3 兼容对象存储（MinIO / 阿里云 OSS / Cloudflare R2 等）。
#
# 合法值只有 local / s3，填别的会**显式启动失败**，不会静默退回 local ——
# 静默降级的结果是照片悄悄换了个地方存，等发现时已经两边都乱了。
COLLECTOR_PHOTO_DRIVER=local

# local 驱动的落盘目录（默认：数据库文件所在目录下的 photos/，即与库一起备份）。
# 存储按内容寻址：sha256 前两级分桶（ab/cd/abcdef….png），同一张图重复上传只存一份。
COLLECTOR_PHOTO_LOCAL_DIR=
# 对外图片地址前缀。设了之后接口返回的 url 会用它拼（适合 CDN / 反代到别的域名），
# 留空则返回本站的相对路径 /api/photos/…（同源部署下这是最简单也最稳的选择）。
COLLECTOR_PHOTO_PUBLIC_BASE=
# 单张图片大小上限（默认 8MB）与本地驱动下的文件总数上限（默认 20000）。
# 文件数上限是给磁盘上的照片兜底的：到了上限会拒绝新的上传，而不是把磁盘写满。
COLLECTOR_PHOTO_MAX_BYTES=8mb
COLLECTOR_PHOTO_MAX_FILES=20000
# 是否允许不带实例身份的匿名上传（默认 true，为了老版本实例和手工导入）。
# 关掉匿名上传后，未携带 x-collector-key 的上传一律 401。
COLLECTOR_PHOTO_ALLOW_ANONYMOUS=true
# 是否拒收仍带元数据的图片（EXIF / GPS / 相机参数 / XMP），默认 true。
# 上报端（HomeBucket）会先剥离；这里还扫得到就说明那边的剥离没生效，
# 与其存下来不如明确拒绝。某种格式在现网误判时，可临时改成 false 放开。
COLLECTOR_PHOTO_REJECT_EXIF=true

# s3 驱动（COLLECTOR_PHOTO_DRIVER=s3 时，endpoint/bucket/ak/sk 四项缺任何一个都会启动失败）
COLLECTOR_S3_ENDPOINT=
COLLECTOR_S3_REGION=us-east-1
COLLECTOR_S3_BUCKET=
COLLECTOR_S3_ACCESS_KEY_ID=
COLLECTOR_S3_SECRET_ACCESS_KEY=
# 对象键前缀（默认 photos/）
COLLECTOR_S3_PREFIX=photos/
# MinIO 等需要 path-style（http://host/bucket/key）时保持 true；
# 只有用 AWS 官方域名那种 virtual-host 风格时才设为 false。
COLLECTOR_S3_FORCE_PATH_STYLE=true
# 想直接给客户端 S3 直链（配合 CDN）时填这里；留空则图片仍走收集器转发
COLLECTOR_S3_PUBLIC_BASE=

# ── 出站同步（"上级数据库"适配层）────────────────────────────────────
# 收集器把**有条码**的条目推给上级数据库。对方是另一个独立项目、接口由对方定，
# 所以这里只做规则化的传输：收集器发出的载荷格式由 sync.service 定义并与传输解耦。
#
# off  —— 不主动外发（默认）。收集器仍会提供只读导出接口（GET /api/v1/export），
#         等对方来拉。首次对接、或对方还没准备好时用这个。
# http —— 向 COLLECTOR_SYNC_ENDPOINT 发 JSON（POST 新增、PATCH 补字段、图片另传）。
# file —— 把载荷写成文件落到 COLLECTOR_SYNC_DIR，交给对方自行取走（离线摆渡）。
#
# 合法值只有 off / http / file；选 http 必须配 ENDPOINT、选 file 必须配 DIR，
# 否则显式启动失败（宁可起不来，也不要"以为在同步其实没同步"）。
COLLECTOR_SYNC_TRANSPORT=off
COLLECTOR_SYNC_ENDPOINT=
# file 传输的落盘目录（默认：数据库文件所在目录下的 sync/）
COLLECTOR_SYNC_DIR=
# 同步令牌：导出接口（GET /api/v1/export）与对方推回来的 POST /api/v1/import 都要求它。
# 故意**不复用管理员账号** —— 调用方是另一套系统，不该拿到纠错台的口令。
# 留空时导出接口一律 401（不配就是关掉，不要把"内网"当安全边界）。
# 用 Authorization: Bearer <token> 或 x-collector-sync-token 头传。
COLLECTOR_SYNC_TOKEN=
# 自动同步间隔（分钟）。**0 = 只手动**（在"上级数据库"页面点"立即同步"），默认 0：
# 自动往外部系统写数据这件事，要先确认对方能收，再打开定时。
COLLECTOR_SYNC_INTERVAL_MINUTES=0
# 每次同步扫描的条目数上限、单次请求超时、失败重试上限（超过就留在失败清单里）
COLLECTOR_SYNC_BATCH_SIZE=200
COLLECTOR_SYNC_TIMEOUT_MS=10000
COLLECTOR_SYNC_MAX_ATTEMPTS=5
# 是否连图片一起上传（默认 true：先把外链图片下载回来再转发，避免对方访问不到内网图床）
COLLECTOR_SYNC_INCLUDE_PHOTOS=true

# ── 开关与限额 ────────────────────────────────────────────────────────
# 是否允许实例自我注册（默认开）。关掉后只有已注册的实例能上报，新实例拿到 403。
COLLECTOR_REGISTRATION_OPEN=true

# 对外访问控制
COLLECTOR_CORS_ORIGIN=*
COLLECTOR_MAX_BODY_SIZE=64kb
# 每个来源 IP 在每个窗口内的请求上限（查询/注册/上报共用一份预算；管理接口不限流）
COLLECTOR_RATE_LIMIT=240
COLLECTOR_RATE_WINDOW_MS=60000

NODE_ENV=development
