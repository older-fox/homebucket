# HomeBucket Collector（后端）环境变量 —— 复制成 collector/server/.env 后按需修改。
# 这个服务是独立程序：只读它自己工作目录下的 .env，不读仓库根目录的 .env，也不读 server/ 的配置。

# 监听地址
COLLECTOR_PORT=3400
COLLECTOR_HOST=0.0.0.0
COLLECTOR_API_PREFIX=api

# 存储：v1 只支持 sqlite（单文件、零外部依赖；收集器读多写少，够用很久）
COLLECTOR_DB_FILE_PATH=data/collector.db
# 启动时自动跑迁移（生产建议 true：镜像里不必再单独跑一次迁移）
COLLECTOR_AUTO_MIGRATE=true

# 管理令牌：纠错台（改字段/屏蔽上报/合并物品/封禁实例）用它鉴权。
# 生产环境（NODE_ENV=production）必须显式设置且 ≥8 字符，否则拒绝启动。
# 注意：实例上报**不需要**这个令牌 —— 实例是自我注册的，见 README 的协议说明。
COLLECTOR_ADMIN_TOKEN=

# 是否允许实例自我注册（默认开）。关掉后只有已注册的实例能上报，新实例拿到 403。
COLLECTOR_REGISTRATION_OPEN=true

# 前端静态产物目录（默认 ../web/dist，即 collector/web 构建输出）
COLLECTOR_WEB_DIR=../web/dist

# 对外访问控制
COLLECTOR_CORS_ORIGIN=*
COLLECTOR_MAX_BODY_SIZE=64kb
# 每个来源 IP 在每个窗口内的请求上限（查询/注册/上报共用一份预算）
COLLECTOR_RATE_LIMIT=240
COLLECTOR_RATE_WINDOW_MS=60000

NODE_ENV=development
