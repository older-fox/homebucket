{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    // 只列真正提供全局类型的包；TypeScript 6 起 @types 不再被隐式全部加载
    "types": ["node"],
    "strictNullChecks": true,
    "noImplicitAny": false,
    // 实体（@Column）与 DTO（class-validator）都是先声明、由框架赋值的，严格属性初始化会全报错
    "strictPropertyInitialization": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false
  },
  // typeorm CLI（db:*）用 ts-node 加载 data-source.ts；迁移脚本本身不需要类型检查
  "ts-node": {
    "transpileOnly": true
  },
  // 只编译服务端源码：同一个项目里还有 web/（前端 SPA）与 vite.config.ts，
  // 缺了 include 时 TypeScript 会按默认的 **/* 把它们一起收进来，rootDir 立刻报 TS6059。
  // 前端由 tsconfig.web.json（vue-tsc）负责。
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "public", "web", "test"]
}
