// ⚠️ 自动生成，请勿手动编辑。
// 模型定义见 prisma/src/models.prisma，改完执行 npm run prisma:build

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_FILE_PATH")
}

// Homebucket 数据模型（唯一来源）
//
// 该文件只放 model，不放 datasource / generator：
// scripts/build-schemas.mjs 会把它拼上不同 provider 的头，生成
//   prisma/mysql/schema.prisma   （provider = mysql）
//   prisma/sqlite/schema.prisma  （provider = sqlite，"MySQL light"）
//
// 约束（必须同时兼容 mysql 与 sqlite，否则生成的 sqlite schema 会报错）：
//   1. 不要用 enum        —— sqlite 不支持，统一用 String + 注释说明取值
//   2. 不要用 @db.*       —— 原生类型只有 mysql 支持
//   3. 不要用 Json        —— sqlite 不支持，用 String 存 JSON 字符串
//   4. 不要用 BigInt      —— 统一 Int / Float / Decimal

// ============ 账号 / 家庭 ============

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  username        String   @unique
  passwordHash    String
  locale          String   @default("zh-CN")
  defaultFamilyId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  defaultFamily  Family?        @relation("DefaultFamily", fields: [defaultFamilyId], references: [id], onDelete: SetNull)
  memberships    FamilyMember[]
  ownedFamilies  Family[]       @relation("FamilyOwner")
  createdInvites FamilyInvite[]
  uploads        Attachment[]
}

/// 一个用户注册时自动创建自己的个人家庭；接受邀请后会加入更多家庭
model Family {
  id         Int      @id @default(autoincrement())
  name       String
  currency   String   @default("CNY")
  locale     String   @default("zh-CN")
  timeZone   String   @default("Asia/Shanghai")
  isPersonal Boolean  @default(false)
  ownerId    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner           User             @relation("FamilyOwner", fields: [ownerId], references: [id])
  members         FamilyMember[]
  invites         FamilyInvite[]
  locations       Location[]
  items           Item[]
  itemUnits       ItemUnit[]
  tags            Tag[]
  templates       Template[]
  attachments     Attachment[]
  notifiers       NotificationChannel[]
  defaultForUsers User[]           @relation("DefaultFamily")
}

model FamilyMember {
  id        Int      @id @default(autoincrement())
  familyId  Int
  userId    Int
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

/// 邀请链接：token 人人可用，可设过期时间，owner 可撤销
model FamilyInvite {
  id          Int       @id @default(autoincrement())
  familyId    Int
  token       String    @unique
  createdById Int
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// ============ 附件 ============

/// 上传的图片/文件。local 模式 url 为空，前端用 /api/media/<key>；s3 模式存完整 url
model Attachment {
  id           Int      @id @default(autoincrement())
  familyId     Int
  key          String
  url          String?
  mime         String
  size         Int
  width        Int?
  height       Int?
  uploadedById Int?
  createdAt    DateTime @default(now())

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  coverForItem Item[]        @relation("ItemCover")
  galleryItems Item[]        @relation("ItemImages")
  locations    Location[]    @relation("LocationImage")
  templates    Template[]    @relation("TemplateImage")

  @@index([familyId])
}

// ============ 位置（树形） ============

model Location {
  id          Int      @id @default(autoincrement())
  familyId    Int
  parentId    Int?
  name        String
  description String?
  imageId     Int?
  sortIndex   Float    @default(0)
  qrToken     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent    Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Location[]   @relation("LocationTree")
  image     Attachment?  @relation("LocationImage", fields: [imageId], references: [id], onDelete: SetNull)
  items     Item[]
  itemUnits ItemUnit[]
  templates Template[]

  @@index([familyId, parentId, sortIndex])
}

// ============ 物品 ============

model Item {
  id           Int      @id @default(autoincrement())
  familyId     Int
  name         String
  description  String?
  quantity     Int      @default(1)
  price        Decimal  @default(0) // 家庭主货币
  model        String?
  manufacturer String?
  /// 商品条码（EAN-13 / UPC 等），家庭内唯一；扫码解析优先级最高
  barcode      String?
  locationId   Int?
  templateId   Int?
  coverImageId Int?
  qrToken      String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  template   Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  coverImage Attachment?  @relation("ItemCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  images     Attachment[] @relation("ItemImages")
  units      ItemUnit[]
  tags       Tag[]        @relation("ItemTags")

  @@unique([familyId, barcode])
  @@index([familyId, createdAt])
  @@index([familyId, locationId])
  @@index([familyId, name])
}

/// 单个序列号/条码对应的实体，可以各自放在不同位置
model ItemUnit {
  id         Int      @id @default(autoincrement())
  familyId   Int
  itemId     Int
  sn         String?
  locationId Int?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  item     Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([familyId, sn])
  @@index([familyId, itemId])
}

// ============ 标签 / 模板 ============

model Tag {
  id        Int      @id @default(autoincrement())
  familyId  Int
  name      String
  color     String   @default("#14b8a6")
  createdAt DateTime @default(now())

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items     Item[]     @relation("ItemTags")
  templates Template[] @relation("TemplateTags")

  @@unique([familyId, name])
}

model Template {
  id                Int      @id @default(autoincrement())
  familyId          Int
  name              String
  description       String?
  /// 模板关联的商品条码：扫这个码可以找到模板并预填新建物品
  barcode           String?
  imageId           Int?
  quantity          Int      @default(1)
  price             Decimal  @default(0)
  model             String?
  manufacturer      String?
  defaultLocationId Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  family          Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  image           Attachment? @relation("TemplateImage", fields: [imageId], references: [id], onDelete: SetNull)
  defaultLocation Location?   @relation(fields: [defaultLocationId], references: [id], onDelete: SetNull)
  tags            Tag[]       @relation("TemplateTags")
  items           Item[]

  @@unique([familyId, barcode])
  @@index([familyId, name])
}

// ============ 通知器 ============

model NotificationChannel {
  id        Int      @id @default(autoincrement())
  familyId  Int
  type      String // smtp | googlechat | telegram | discord | dingtalk | feishu | wecom | bark | serverchan
  name      String
  enabled   Boolean  @default(true)
  config    String // JSON 字符串（各类型字段不同）
  events    String   @default("") // 逗号分隔的事件名，空表示全部
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}
